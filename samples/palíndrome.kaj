.esPalindromo(.palabra, .longitud) [
    @let .izquierda = 0;
    @let .derecha = .longitud - 1;

    @while (.izquierda < .derecha) [
        @if (.palabra[.izquierda] != .palabra[.derecha]) [
            @return 0;
        ]

        .izquierda += 1;
        .derecha -= 1;
    ]

    @return 1;
]

.main() [
    @let .palabra = "anitalavalatina";

    @print(.esPalindromo(.palabra, 15));
]